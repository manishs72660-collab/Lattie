PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# MongoDB is used only for user accounts and password hashes.
MONGODB_URI=

# Qdrant stores document vectors, document metadata and graph payloads.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=portfolio_knowledge
# gemini-embedding-001 outputs 3072 dimensions by default.
GEMINI_EMBEDDING_DIM=3072

# Cloudinary stores the original uploaded files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq runs chat/completion requests; Gemini generates embeddings.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional web search and Redis-backed rate limiting.
TAVILY_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

MAX_FILE_MB=10
MAX_GRAPH_CHUNKS=40
MAX_REWRITES=2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
RAG_RATE_LIMIT_WINDOW_MS=900000
RAG_RATE_LIMIT_MAX=15
